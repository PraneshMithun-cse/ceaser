{
  "expo": {
    "name": "Buylo",
    "slug": "buylo",
    "scheme": "buylo",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/brand/buylo-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F0DF",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#F4F0DF"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F0DF",
        "foregroundImage": "./assets/brand/buylo-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.buylo",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/brand/buylo-icon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/RocGrotesk-Black.otf",
            "./assets/fonts/ThingsToRemember-Regular.otf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F0DF",
          "image": "./assets/brand/splash-transparent.png",
          "imageWidth": 1
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "@clerk/expo",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Buylo uses your location to show nearby vendors and delivery estimates."
        }
      ]
    ]
  }
}
