{
  "expo": {
    "name": "Buylo",
    "slug": "buylo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/buylo-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F0DF",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#F4F0DF"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F0DF",
        "foregroundImage": "./assets/brand/buylo-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.buylo"
    },
    "web": {
      "favicon": "./assets/brand/buylo-icon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F0DF",
          "image": "./assets/brand/splash-transparent.png",
          "imageWidth": 1
        }
      ],
      "expo-image"
    ]
  }
}
